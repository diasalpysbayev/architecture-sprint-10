@startuml
package "Система Медицинских Данных" {

  actor Клиент
  actor Администратор
  actor Врач
  actor Бухгалтер

  package "Регистрация и Запись" {
    usecase "Регистрация пациента" as U1
    usecase "Запись на прием" as U2
  }

  package "Прием и Обслуживание" {
    usecase "Прием у врача" as U3
    usecase "Создание медицинских записей" as U4
  }

  package "Финансовые Операции" {
    usecase "Оплата услуг" as U5
    usecase "Формирование отчетов" as U6
  }

  package "Безопасность данных" {
    usecase "Шифрование данных" as S1
    usecase "Обезличивание данных" as S2
    usecase "Контроль доступа" as S3
    usecase "Мониторинг безопасности" as S4
  }

  Клиент --> U1
  Клиент --> U2
  Клиент --> U3
  Клиент --> U5

  Администратор --> U1
  Администратор --> U2
  Администратор --> U6

  Врач --> U3
  Врач --> U4

  Бухгалтер --> U5
  Бухгалтер --> U6

  U1 ..> S1 : "Шифрование персональных данных"
  U3 ..> S2 : "Обезличивание медицинских записей"
  U5 ..> S3 : "Контроль доступа к платежной информации"
  U6 ..> S4 : "Логирование финансовых операций"

}
@enduml